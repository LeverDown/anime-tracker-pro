# AnimeTracker Backend Configuration Template
# COPY THIS TO .env AND FILL IN THE VALUES

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/roninhub
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=roninhub

# Redis
USE_REDIS=true
REDIS_URL=redis://localhost:6379/0

# Security (ROTATE THESE IN PRODUCTION)
JWT_SECRET=generate_a_long_random_string_here
ALGORITHM=HS256

# Monitoring
SENTRY_DSN=
